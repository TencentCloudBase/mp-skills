{
  "name": "mp-skills",
  "version": "0.1.0",
  "description": "CLI for adding AI Skills to WeChat Mini Programs via wx.modelContext",
  "type": "module",
  "bin": {
    "mp-skills": "./bin/mp-skills.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "templates/",
    "references/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node bin/mp-skills.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@cloudbase/cli": "^3.5.6",
    "@cloudbase/manager-node": "^5.5.3",
    "cli-table3": "^0.6.5",
    "commander": "^12.0.0",
    "enquirer": "^2.4.1",
    "nanospinner": "^1.2.2",
    "opencode-ai": "^1.17.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "wechat",
    "miniprogram",
    "ai",
    "wx-modelcontext",
    "skills"
  ],
  "license": "MIT",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}