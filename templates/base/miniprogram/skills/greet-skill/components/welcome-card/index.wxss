.welcome-card {
  background: #fff;
  border-radius: 16px;
  padding: 24px;
  margin: 16px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
}

.header {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 20px;
}

.avatar {
  font-size: 40px;
  flex-shrink: 0;
}

.header-text {
  flex: 1;
}

.greeting {
  font-size: 18px;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.5;
}

.tip {
  display: block;
  font-size: 13px;
  color: rgba(0, 0, 0, 0.45);
  margin-top: 4px;
  line-height: 1.5;
}

.actions-title,
.recommend-title {
  font-size: 14px;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.85);
  margin-bottom: 10px;
}

.actions-list {
  display: flex;
  gap: 8px;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  background: #f5f5f5;
  border-radius: 12px;
  padding: 12px 8px;
}

.action-icon {
  font-size: 24px;
}

.action-label {
  font-size: 12px;
  color: rgba(0, 0, 0, 0.65);
}

.recommend {
  margin-top: 16px;
}

.skill-tags {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.skill-tag {
  background: #f0f7ff;
  border-radius: 10px;
  padding: 10px 12px;
}

.skill-name {
  display: block;
  font-size: 13px;
  font-weight: 500;
  color: #1677ff;
  margin-bottom: 2px;
}

.skill-desc {
  display: block;
  font-size: 12px;
  color: rgba(0, 0, 0, 0.45);
}
